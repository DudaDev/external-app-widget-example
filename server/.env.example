# Copy this file to server/.env and fill in your values
# Run the server from the server/ directory: cd server && npm start
# Starting from the project root causes .env not to load — tokens silently return {}

# Spotify API credentials
# Get these from https://developer.spotify.com/dashboard
# Missing CLIENT_ID or CLIENT_SECRET: /spotify/* returns 500 and the widget never loads
EXTERNAL_API_CLIENT_ID=your_spotify_client_id
EXTERNAL_API_CLIENT_SECRET=your_spotify_client_secret

# Spotify API base URL, no trailing slash
# No reason to change this unless Spotify moves their API
EXTERNAL_API_BASE_URL=https://api.spotify.com/v1