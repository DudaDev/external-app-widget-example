# Copy this file to wrangler.toml (gitignored) and fill in your own values
# before running `wrangler deploy`. wrangler.toml itself is never committed —
# it names your real backend domain, which shouldn't be baked into a shared
# template repo.
name = "ext-app-widget-backend"
main = "src/index.ts"
compatibility_date = "2026-08-21"

# Custom domain on your own zone — that zone must already be active in your
# Cloudflare account for the route to provision successfully. Custom Domains
# cover the whole hostname; no wildcard/path is allowed here (unlike a
# regular zone route pattern).
routes = [
  { pattern = "YOUR_BACKEND_DOMAIN", custom_domain = true }
]

# Non-secret config. Secrets — EXTERNAL_API_CLIENT_ID/SECRET, DUDA_API_USER/
# PASSWORD, INSTANT_SITE_EMBED_TOKEN, FORM_BACKEND_URL, FORM_BACKEND_TOKEN —
# are NOT here — set those with `wrangler secret put`, never committed.
# FORM_BACKEND_URL/TOKEN point at a form-capture-backend deployment (see
# that repo) and are secrets rather than plain vars because the URL+token
# pair together are what let a caller relay data into that backend; no
# reason to expose either unnecessarily.
[vars]
EXTERNAL_API_BASE_URL = "https://api.spotify.com/v1"
# Bare hostnames, "*." prefix = any subdomain (not the bare root domain) — see src/origin.ts
ALLOWED_ORIGINS = "my.duda.co,*.multiscreensite.com,*.YOUR_ROOT_DOMAIN"
DUDA_API_BASE_URL = "https://api.duda.co/api"

# Cloudflare's native Rate Limiting binding — replaces express-rate-limit's
# in-memory counter, which wouldn't be meaningful across Worker isolates anyway.
# period must be 10 or 60 (seconds). namespace_id is an arbitrary label you
# pick, not a Cloudflare-assigned resource id — any unique string works.
[[unsafe.bindings]]
name = "RATE_LIMITER"
type = "ratelimit"
namespace_id = "1001"
simple = { limit = 30, period = 60 }
