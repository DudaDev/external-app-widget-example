{
  "name": "dm-external-widget",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@fontsource/roboto": "^5.2.10",
    "@mui/icons-material": "^9.1.1",
    "@mui/material": "^9.1.2",
    "jose": "^6.2.10",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-use-audio-player": "^4.0.0",
    "siriwave": "^2.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/supertest": "^7.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.8",
    "concurrently": "^9.0.0",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^17.4.0",
    "jsdom": "^29.0.1",
    "prettier": "^3.8.1",
    "supertest": "^7.2.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.0",
    "vite": "^8.0.2",
    "vite-plugin-css-injected-by-js": "^4.0.1",
    "vite-plugin-svgr": "^4.0.0",
    "vitest": "^4.1.1",
    "wait-on": "^9.0.4"
  },
  "scripts": {
    "start": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "build:shared-react": "vite build --config shared-react/vite.config.ts",
    "build:preview-bundles": "npm run build:shared-react && node scripts/build-preview-bundles.mjs",
    "build:preview-site": "vite build --config preview/vite.config.ts",
    "dev": "concurrently \"npm start\" \"npm start --prefix server\"",
    "lint": "eslint src server worker preview shared-react",
    "format": "prettier --write src server worker preview shared-react",
    "type-check": "tsc --noEmit && tsc --noEmit -p server/tsconfig.json && tsc --noEmit -p worker/tsconfig.json && tsc --noEmit -p preview/tsconfig.json && tsc --noEmit -p shared-react/tsconfig.json",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage"
  }
}
